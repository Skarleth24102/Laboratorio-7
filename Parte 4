// PARTE 4: Rangos normales de las variables simuladas

#define TEMP_MIN 36.0f
#define TEMP_MAX 38.0f

#define OXIG_MIN 95.0f
#define OXIG_MAX 100.0f

#define HUM_MIN 40.0f
#define HUM_MAX 60.0f

/* USER CODE END PD */

