volatile uint16_t ADCValor[3];

volatile uint8_t estadoADC = 0;

uint16_t contador = 0;

char mensajeUART[220];

// PARTE 4: Variables simuladas
float temperatura = 0.0f;
float oxigenacion = 0.0f;
float humedad = 0.0f;

// PARTE 4: Estados de las alarmas
uint8_t alarmaTemp = 0;
uint8_t alarmaOxig = 0;
uint8_t alarmaHum = 0;

