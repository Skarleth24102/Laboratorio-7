/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_USART2_UART_Init();

  /* USER CODE BEGIN 2 */

  // Iniciamos ADC con DMA para los 3 potenciometros
  HAL_ADC_Start_DMA(&hadc1, (uint32_t *)ADCValor, 3);

  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED2);

  /* Initialize USER push-button */
  BSP_PB_Init(BUTTON_USER, BUTTON_MODE_EXTI);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

    contador++;

    HAL_Delay(500);


    // =====================================================
    // PARTE 4: MAPEO DE LOS POTENCIOMETROS
    // =====================================================

    // POT 1: Temperatura de 30 a 42 grados Celsius
    temperatura = map(ADCValor[0], 0, 4095, 30, 42);

    // POT 2: Oxigenacion de 85 a 100 %
    oxigenacion = map(ADCValor[1], 0, 4095, 85, 100);

    // POT 3: Humedad relativa de 0 a 100 %
    humedad = map(ADCValor[2], 0, 4095, 0, 100);


    // =====================================================
    // PARTE 4: RANGOS Y ALARMAS
    // =====================================================

    // LED VERDE: Temperatura fuera de 36 a 38 grados
    if (temperatura < TEMP_MIN || temperatura > TEMP_MAX)
    {
        alarmaTemp = 1;

        HAL_GPIO_WritePin(
            VERDE_GPIO_Port,
            VERDE_Pin,
            GPIO_PIN_SET
        );
    }
    else
    {
        alarmaTemp = 0;

        HAL_GPIO_WritePin(
            VERDE_GPIO_Port,
            VERDE_Pin,
            GPIO_PIN_RESET
        );
    }


    // LED ROJO: Oxigenacion fuera de 95 a 100 %
    if (oxigenacion < OXIG_MIN || oxigenacion > OXIG_MAX)
    {
        alarmaOxig = 1;

        HAL_GPIO_WritePin(
            ROJO_GPIO_Port,
            ROJO_Pin,
            GPIO_PIN_SET
        );
    }
    else
    {
        alarmaOxig = 0;

        HAL_GPIO_WritePin(
            ROJO_GPIO_Port,
            ROJO_Pin,
            GPIO_PIN_RESET
        );
    }


    // LED AMARILLO: Humedad fuera de 40 a 60 %
    if (humedad < HUM_MIN || humedad > HUM_MAX)
    {
        alarmaHum = 1;

        HAL_GPIO_WritePin(
            AMARILLO_GPIO_Port,
            AMARILLO_Pin,
            GPIO_PIN_SET
        );
    }
    else
    {
        alarmaHum = 0;

        HAL_GPIO_WritePin(
            AMARILLO_GPIO_Port,
            AMARILLO_Pin,
            GPIO_PIN_RESET
        );
    }


    // =====================================================
    // PARTE 3 Y 4: TRANSMISION UART
    // =====================================================

    // Convertir valores a decimas para mostrarlos
    unsigned int temp10 =
        (unsigned int)(temperatura * 10.0f + 0.5f);

    unsigned int oxig10 =
        (unsigned int)(oxigenacion * 10.0f + 0.5f);

    unsigned int hum10 =
        (unsigned int)(humedad * 10.0f + 0.5f);


    // Mostrar ADC, valor simulado y estado de alarma
    snprintf(
        mensajeUART,
        sizeof(mensajeUART),

        "CANAL 1: %4u | Temperatura: %u.%u C | %s\r\n"
        "CANAL 2: %4u | Oxigenacion: %u.%u %% | %s\r\n"
        "CANAL 3: %4u | Humedad: %u.%u %% | %s\r\n"
        "------------------------------------------\r\n",

        (unsigned int)ADCValor[0],
        temp10 / 10,
        temp10 % 10,
        alarmaTemp ? "ALERTA" : "NORMAL",

        (unsigned int)ADCValor[1],
        oxig10 / 10,
        oxig10 % 10,
        alarmaOxig ? "ALERTA" : "NORMAL",

        (unsigned int)ADCValor[2],
        hum10 / 10,
        hum10 % 10,
        alarmaHum ? "ALERTA" : "NORMAL"
    );


    HAL_UART_Transmit(
        &huart2,
        (uint8_t *)mensajeUART,
        (uint16_t)strlen(mensajeUART),
        100
    );


    // =====================================================
    // DMA: Mantener actualizacion de las lecturas
    // =====================================================

    // En modo Circular, DMA sigue funcionando.
    // En modo Normal, se inicia otra transferencia.

    if (estadoADC)
    {
        estadoADC = 0;

        if (hdma_adc1.Init.Mode == DMA_NORMAL)
        {
            HAL_ADC_Stop_DMA(&hadc1);

            HAL_ADC_Start_DMA(
                &hadc1,
                (uint32_t *)ADCValor,
                3
            );
        }
    }

  }
  /* USER CODE END 3 */
}

