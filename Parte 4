// PARTE 4: Funcion MAP para convertir ADC a valores simulados

float map(float valor, float entradaMin, float entradaMax,
          float salidaMin, float salidaMax)
{
    return (valor - entradaMin) * (salidaMax - salidaMin)
           / (entradaMax - entradaMin) + salidaMin;
}

